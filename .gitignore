# Dependencies
node_modules/

# Build caches
*.tsbuildinfo

# Logs and temp
*.log
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Local settings
*.local

# Residue lib layers: root-level output and nested sync copies are never
# committed. NOTE: packages/*/lib/ top-level artifacts ARE committed — they
# are the prebuilt distribution payload (package.json files lists).
/lib/
packages/*/lib/lib/

# arch-lens runtime artifacts (written when the desk scans this workspace)
.arch-lens-*
ARCH-NOTES.md

# arch-lens AI-generated architecture doc (runtime artifact)
docs/architecture.md
