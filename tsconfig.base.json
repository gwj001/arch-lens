{
    "compilerOptions":  {
                            "target":  "es2024",
                            "module":  "esnext",
                            "moduleResolution":  "bundler",
                            "declaration":  true,
                            "sourceMap":  true,
                            "declarationMap":  true,
                            "skipLibCheck":  true,
                            "esModuleInterop":  true,
                            "allowImportingTsExtensions":  true,
                            "rewriteRelativeImportExtensions":  true,
                            "strict":  true,
                            "noUncheckedIndexedAccess":  true,
                            "exactOptionalPropertyTypes":  true,
                            "noImplicitOverride":  true,
                            "noFallthroughCasesInSwitch":  true,
                            "noUnusedLocals":  true,
                            "noUnusedParameters":  true,
                            "types":  [
                                          "node"
                                      ],
                            "jsx":  "react-jsx",
                            "paths":  {
                                          // 本地 workspace / vendored 包：不走 npm。
                                          "@deepseek-ai/dsh-arch-lens-backend":  [
                                                                                     "./packages/arch-lens-backend/lib/types"
                                                                                 ],
                                          "@deepseek-ai/dsh-arch-lens-backend/remote":  [
                                                                                             "./packages/arch-lens-backend/lib/typert.remote-client.d.ts"
                                                                                         ],
                                          "@deepseek-ai/dsh-code-index":  [
                                                                              "./packages/code-index/lib/types"
                                                                          ],
                                          "@deepseek-ai/dsh-typert-protocol":  [
                                                                                   "./packages/typert-protocol/src/index.ts"
                                                                               ],
                                          // 豁免：@deepseek-ai/dsh-client-ui-session 尚未发布到 npm
                                          // （官方 registry 404）；待上游发布 0.1.1-rc.2+ 后删除本条目并改用 npm 依赖。
                                          "@deepseek-ai/dsh-client-ui-session":  [
                                                                                     "../../deepseek-harness/packages/client/ui-session/lib/types"
                                                                                 ],
                                          "@deepseek-ai/dsh-client-ui-session/client":  [
                                                                                             "../../deepseek-harness/packages/client/ui-session/lib/types/client"
                                                                                         ]
                                          // 其余 @deepseek-ai/* 均来自 npm（devDependencies，固定 0.1.1-rc.2 线）。
                                      }
                        }
}